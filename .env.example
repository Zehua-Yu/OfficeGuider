# OfficeGuider 后端环境变量示例（部分仍以 SMARTFLOW_ 为前缀，与代码一致）
#
# Deepseek（OpenAI 兼容）— 用于 POST /dataset/generate
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 可选：加载 train_reinforce.py 导出的权重
# SMARTFLOW_CHECKPOINT=backend/checkpoints/orderer.pt

# SMARTFLOW_DEVICE=cuda
# CORS_ORIGINS=http://localhost:5173

# VON 预训练目录（需含 args.json 与 epoch-*.pt），与 eval.py 加载方式一致；不设置时默认使用 third_party/VON/pretrained/MI
# SMARTFLOW_VON_PRETRAINED=third_party/VON/pretrained/TSP
# 与 /atoms 列表、VON 坐标同源（默认 200 个办公动作）
# SMARTFLOW_OFFICE_CATALOG=data/ordering/atom_embeddings_2d/office_actions_200.json
# SMARTFLOW_ATOMS_2D=data/ordering/atom_embeddings_2d/office_actions_200.json
# 用户通过 Agent 添加的自定义动作（与内置合并后供 VON 使用）
# SMARTFLOW_CUSTOM_ACTIONS_JSON=data/ordering/custom_office_actions.json
